# Set each one on the Vercel project for Production and Preview, and copy to
# .env.local for `vercel dev`. VERCEL_EXPERIMENTAL_BACKENDS=1 is required at
# build time: the default Hono builder resolves neither the `@/` alias nor
# extensionless imports, so the function would fail at import.
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
REVALIDATE_SECRET=
BETTER_AUTH_URL=https://ruchern.dev
REVALIDATE_URL=https://ruchern.dev/api/revalidate
# https://<project>.vercel.app/mcp
MCP_VERCEL_RESOURCE=
VERCEL_EXPERIMENTAL_BACKENDS=1
