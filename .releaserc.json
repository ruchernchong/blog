{
  "tagFormat": "v${version}",
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm version ${nextRelease.version} --no-git-tag-version --no-git-checks && sed -i -E '0,/^version = \".*\"/s//version = \"${nextRelease.version}\"/' apps/cli/Cargo.toml && sed -i -E '/^name = \"usage-ingest\"$/{n;s/^version = \".*\"/version = \"${nextRelease.version}\"/}' apps/cli/Cargo.lock",
        "successCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "CHANGELOG.md",
          "apps/cli/Cargo.toml",
          "apps/cli/Cargo.lock"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "releasedLabels": ["released"],
        "assignees": ["ruchernchong"]
      }
    ]
  ]
}
