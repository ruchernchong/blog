{
  "tagFormat": "v${version}",
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm version ${nextRelease.version} --recursive --no-git-tag-version --no-git-checks",
        "successCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release-extras/verified-git-commit",
      {
        "assets": [
          "package.json",
          "apps/docs/package.json",
          "apps/web/package.json",
          "packages/mcp/package.json",
          "packages/usage/package.json",
          "CHANGELOG.md"
        ]
      }
    ],
    [
      "@semantic-release/github",
      {
        "releasedLabels": ["released"],
        "assignees": ["ruchernchong"]
      }
    ]
  ]
}
