{
  "name": "@workspace/usage",
  "version": "1.41.1",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "measure": "node src/scripts/measure.ts",
    "measure:rust": "cargo run --release --manifest-path rust/Cargo.toml --",
    "ingest:rust": "cargo run --release --manifest-path rust/Cargo.toml -- ingest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format.ts",
    "./heatmap-layout": "./src/heatmap-layout.ts",
    "./ingest": "./src/ingest.ts",
    "./parsers": "./src/parsers/index.ts",
    "./pricing": "./src/pricing.ts",
    "./providers": "./src/providers.ts",
    "./registry": "./src/registry.ts",
    "./types": "./src/types.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
